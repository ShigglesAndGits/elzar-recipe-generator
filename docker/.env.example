# =============================================================================
# ELZAR - AI Recipe Generator for Grocy
# Docker Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# =============================================================================

# =============================================================================
# GROCY CONFIGURATION (Required)
# =============================================================================
# Your Grocy instance URL (no trailing slash)
GROCY_URL=https://your-grocy-instance.com

# Grocy API key (found in Grocy -> Settings -> API keys)
GROCY_API_KEY=your_grocy_api_key_here

# =============================================================================
# LLM CONFIGURATION (Required)
# =============================================================================
# Choose ONE of the following providers:

# --- Option 1: OpenRouter (Recommended - includes free models) ---
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL=google/gemini-2.0-flash-exp:free

# --- Option 2: OpenAI ---
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your_openai_api_key_here
# LLM_MODEL=gpt-4o

# --- Option 3: Ollama (Local/Self-hosted) ---
# Note: Use host.docker.internal to reach host machine from container
# LLM_API_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# --- Option 4: Any OpenAI-compatible API ---
# LLM_API_URL=https://your-api-endpoint.com/v1
# LLM_API_KEY=your_api_key
# LLM_MODEL=your-model-name

# =============================================================================
# VISION MODEL CONFIGURATION (Optional)
# =============================================================================
# For pantry scanning feature - takes photos and identifies food items
# Falls back to LLM settings if not configured
# Must be a model that supports vision/image input (GPT-4o, Gemini, Claude)

# VISION_API_URL=https://openrouter.ai/api/v1
# VISION_API_KEY=your_api_key_here
# VISION_MODEL=google/gemini-2.0-flash-exp:free

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Maximum recipes to keep in history (default: 50)
MAX_RECIPE_HISTORY=50

# Apprise notification URL for sending recipes
# Supports 80+ notification services: https://github.com/caronc/apprise
# Examples:
#   Discord: discord://webhook_id/webhook_token
#   Telegram: tgram://bot_token/chat_id
#   Email: mailto://user:pass@smtp.gmail.com
# Leave empty to disable notifications
APPRISE_URL=

# Unit preference for recipes: "imperial" or "metric" (default: imperial)
UNIT_PREFERENCE=imperial

# Port to expose Elzar on (default: 80)
# Change if port 80 is already in use
ELZAR_PORT=80
